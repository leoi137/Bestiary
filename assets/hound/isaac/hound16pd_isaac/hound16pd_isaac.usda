def Xform "hound16pd_isaac" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    over "Geometry"
    {
        over "trunk" (
            prepend apiSchemas = ["PhysxContactReportAPI"]
        )
        {
            float physxContactReport:threshold = 0

            over "FL_abduct" (
                prepend apiSchemas = ["PhysxContactReportAPI"]
            )
            {
                float physxContactReport:threshold = 0

                over "FL_thigh" (
                    prepend apiSchemas = ["PhysxContactReportAPI"]
                )
                {
                    float physxContactReport:threshold = 0

                    over "FL_calf" (
                        prepend apiSchemas = ["PhysxContactReportAPI"]
                    )
                    {
                        float physxContactReport:threshold = 0

                        over "FL_wheel" (
                            prepend apiSchemas = ["PhysxContactReportAPI"]
                        )
                        {
                            float physxContactReport:threshold = 0
                        }
                    }
                }
            }

            over "FR_abduct" (
                prepend apiSchemas = ["PhysxContactReportAPI"]
            )
            {
                float physxContactReport:threshold = 0

                over "FR_thigh" (
                    prepend apiSchemas = ["PhysxContactReportAPI"]
                )
                {
                    float physxContactReport:threshold = 0

                    over "FR_calf" (
                        prepend apiSchemas = ["PhysxContactReportAPI"]
                    )
                    {
                        float physxContactReport:threshold = 0

                        over "FR_wheel" (
                            prepend apiSchemas = ["PhysxContactReportAPI"]
                        )
                        {
                            float physxContactReport:threshold = 0
                        }
                    }
                }
            }

            over "RL_abduct" (
                prepend apiSchemas = ["PhysxContactReportAPI"]
            )
            {
                float physxContactReport:threshold = 0

                over "RL_thigh" (
                    prepend apiSchemas = ["PhysxContactReportAPI"]
                )
                {
                    float physxContactReport:threshold = 0

                    over "RL_calf" (
                        prepend apiSchemas = ["PhysxContactReportAPI"]
                    )
                    {
                        float physxContactReport:threshold = 0

                        over "RL_wheel" (
                            prepend apiSchemas = ["PhysxContactReportAPI"]
                        )
                        {
                            float physxContactReport:threshold = 0
                        }
                    }
                }
            }

            over "RR_abduct" (
                prepend apiSchemas = ["PhysxContactReportAPI"]
            )
            {
                float physxContactReport:threshold = 0

                over "RR_thigh" (
                    prepend apiSchemas = ["PhysxContactReportAPI"]
                )
                {
                    float physxContactReport:threshold = 0

                    over "RR_calf" (
                        prepend apiSchemas = ["PhysxContactReportAPI"]
                    )
                    {
                        float physxContactReport:threshold = 0

                        over "RR_wheel" (
                            prepend apiSchemas = ["PhysxContactReportAPI"]
                        )
                        {
                            float physxContactReport:threshold = 0
                        }
                    }
                }
            }
        }
    }
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
}

over "Flattened_Prototype_17"
{
    def Shader "PreviewSurface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </Flattened_Prototype_17.inputs:diffuseColor>
        color3f inputs:emissiveColor.connect = </Flattened_Prototype_17.inputs:emissiveColor>
        float inputs:metallic.connect = </Flattened_Prototype_17.inputs:metallic>
        float inputs:opacity.connect = </Flattened_Prototype_17.inputs:opacity>
        float inputs:roughness.connect = </Flattened_Prototype_17.inputs:roughness>
        token outputs:displacement
        token outputs:surface
    }
}

